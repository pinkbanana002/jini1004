    "# [ Cell 5 ] (Header_Fixed) 추가이미지 컬럼 포함 및 시트 업로드\n",
    "import pandas as pd\n",
    "import gspread\n",
    "from gspread_dataframe import set_with_dataframe\n",
    "import time\n",
    "\n",
    "print(f\"▶️ [ Cell 5 ] 최종 데이터를 구글 시트에 업로드합니다...\")\n",
    "\n",
    "# 구글 시트 연결 확인\n",
    "if 'doc' not in globals():\n",
    "    try:\n",
    "        from google.oauth2.service_account import Credentials\n",
    "        scope = ['https://www.googleapis.com/auth/spreadsheets', 'https://www.googleapis.com/auth/drive']\n",
    "        creds = Credentials.from_service_account_file('key.json', scopes=scope)\n",
    "        client = gspread.authorize(creds)\n",
    "        doc = client.open_by_url(SHEET_URL)\n",
    "    except:\n",
    "        print(\"\\n❌ [오류] 구글 시트 연결(doc)이 끊어졌습니다! [ Cell 2 ]를 실행하세요.\")\n",
    "        raise NameError(\"구글 시트 연결 끊김\")\n",
    "\n",
    "if 'results_list' in locals() and results_list:\n",
    "    try:\n",
    "        worksheet = doc.worksheet('상품등록목록')\n",
    "        \n",
    "        # 1. 데이터 프레임 생성\n",
    "        df_final = pd.DataFrame(results_list).fillna(\"\")\n",
    "        \n",
    "        # 2. 컬럼 순서 정리 (‼️ 추가이미지명 포함)\n",
    "        # 이 순서가 틀어지면 수식(S, T, U...)이 꼬이므로 순서를 꼭 지켜야 합니다.\n",
    "        standard_headers = [\n",
    "            '재질', '상품링크', '포장사이즈', '무게', '세트',            # A ~ E\n",
    "            '원본상품명', '변환상품명', '메인키워드', '대표이미지경로',  # F ~ I\n",
    "            '옵션1', '옵션2', '한글 옵션명', '중국 옵션명',                # J ~ M\n",
    "            'COPY폴더 경로', '사이즈', '태그', '대표이미지링크',          # N ~ Q\n",
    "            '전체옵션명',                                                   # R\n",
    "            '1688', '원가', '공급가', '쿠팡판매가', '권장가', '내마진', '쿠팡마진', # S ~ Y (수식 영역)\n",
    "            '임시파일명', '상세이미지파일명',                               # Z ~ AA\n",
    "            '추가이미지명', '추가이미지명2'                                 # AB ~ AC (‼️ 추가됨)\n",
    "        ]\n",
    "        \n",
    "        # 빠진 컬럼 빈칸 처리\n",
    "        for col in standard_headers:\n",
    "            if col not in df_final.columns: df_final[col] = \"\"\n",
    "        \n",
    "        # 순서 강제 적용\n",
    "        df_final = df_final[standard_headers]\n",
    "\n",
    "        # 3. 업로드\n",
    "        print(\"    🧹 시트를 초기화하고 데이터를 올립니다 (AB, AC열 포함)...\")\n",
    "        worksheet.clear() \n",
    "        set_with_dataframe(worksheet, df_final, include_column_header=True)\n",
    "        \n",
