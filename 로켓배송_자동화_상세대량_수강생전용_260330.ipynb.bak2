  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8bda9fc4-79ca-4981-ac9a-f69fc6dba4ef",
   "metadata": {},
   "outputs": [],
   "source": [
    "# =====================================================\n",
    "# [ Cell 4-1 ] 신버전 - 직접 URL 접근 방식 (리뉴얼 대응 + 속도 개선)\n",
    "# =====================================================\n",
    "import time, re\n",
    "from selenium.webdriver.common.by import By\n",
    "from selenium.webdriver.support.ui import WebDriverWait\n",
    "from selenium.webdriver.support import expected_conditions as EC\n",
    "\n",
    "print(\"▶️ [ Cell 4-1 ] 상세 로그 모드 및 데이터 채굴 엔진 가동 🚀...\")\n",
    "\n",
    "try:\n",
    "    from deep_translator import GoogleTranslator\n",
    "    translator = GoogleTranslator(source='auto', target='ko')\n",
    "except: pass\n",
    "\n",
    "crawled_buffer = []\n",
    "wait = WebDriverWait(driver, 15)\n",
    "\n",
    "# ──────────────────────────────────────────\n",
    "# 🧹 유틸 함수들\n",
    "# ──────────────────────────────────────────\n",
    "\n",
    "def clean_text_for_system(text):\n",
    "    \"\"\"윈도우 파일명 금지문자 제거, * → x 치환\"\"\"\n",
    "    if not text: return \"\"\n",
    "    text = str(text)\n",
    "    # 1. * (별표)는 사이즈 표기일 수 있으므로 'x'로 치환\n",
    "    text = text.replace('*', 'x').replace('＊', 'x')\n",
    "    # 2. 윈도우 파일명 금지 문자 제거\n",
    "    text = re.sub(r'[\\\\/:*?\"<>|]', '', text).strip()\n",
    "    return text\n",
    "\n",
    "def parse_price_robust(text):\n",
    "    \"\"\"텍스트에서 숫자만 추출해서 float 반환\"\"\"\n",
    "    if not text: return 0.0\n",
    "    clean = \"\".join(re.findall(r'[\\d\\.]+', str(text)))\n",
    "    try: return float(clean) if clean else 0.0\n",
    "    except: return 0.0\n",
    "\n",
    "def extract_itid(link):\n",
    "    \"\"\"\n",
    "    1688 링크 또는 소싱라이프 링크에서 itId 숫자 추출\n",
    "    - 소싱라이프: ?itId=12345\n",
    "    - 1688: /offer/12345.html\n",
    "    \"\"\"\n",
    "    m = re.search(r'itId=(\\d+)', link)\n",
    "    if m: return m.group(1)\n",
    "    m = re.search(r'/offer/(\\d+)', link)\n",
    "    if m: return m.group(1)\n",
    "    return None\n",
    "\n",
    "def wait_for_page(driver, timeout=10):\n",
    "    \"\"\"\n",
    "    .option-dropdown 이 DOM에 뜰 때까지 대기\n",
    "    → Next.js 렌더링 완료 신호로 사용\n",
    "    \"\"\"\n",
    "    try:\n",
    "        WebDriverWait(driver, timeout).until(\n",
    "            EC.presence_of_element_located((By.CSS_SELECTOR, \".option-dropdown\"))\n",
    "        )\n",
    "        time.sleep(0.3)  # 추가 안정화 대기\n",
    "        return True\n",
    "    except:\n",
    "        return False\n",
    "\n",
    "def parse_body_text(body_text):\n",
    "    \"\"\"\n",
    "    body 텍스트에서 상품명/가격 추출\n",
    "    - 상품명: '원문보기' 바로 앞 줄\n",
    "    - 원화 가격: '가격 (₩, 원)' 다음 줄\n",
    "    - 위안화 가격: '가격 (¥, 위안)' 다음 줄\n",
    "    \"\"\"\n",
    "    title = ''\n",
    "    price_krw = 0.0\n",
    "    price_cny = 0.0\n",
    "\n",
    "    lines = [l.strip() for l in body_text.split('\\n') if l.strip()]\n",
    "\n",
    "    for i, line in enumerate(lines):\n",
    "        if line == '원문보기' and i > 0:\n",
    "            title = lines[i - 1]\n",
    "        if '가격 (₩' in line and i + 1 < len(lines):\n",
    "            price_krw = parse_price_robust(lines[i + 1])\n",
    "        if '가격 (¥' in line and i + 1 < len(lines):\n",
    "            price_cny = parse_price_robust(lines[i + 1])\n",
    "\n",
    "    return title, price_krw, price_cny\n",
    "\n",
    "def collect_opts_from_dropdown(driver, dd_index):\n",
    "    \"\"\"\n",
    "    특정 인덱스의 드롭다운 열어 옵션 전량 수집\n",
    "    - 매번 DOM 재탐색 (StaleElement 방지)\n",
    "    - 스크롤 내리며 전량 수집\n",
    "    - 이미지 있으면 img src 포함\n",
    "    반환: (label명, [{name, price, img}, ...])\n",
    "    \"\"\"\n",
    "    try:\n",
    "        # ⭐ 매번 DOM 재탐색 (StaleElement 방지)\n",
    "        dropdowns = driver.find_elements(By.CSS_SELECTOR, \".option-dropdown\")\n",
    "        if dd_index >= len(dropdowns):\n",
    "            return None, []\n",
    "\n",
    "        dd = dropdowns[dd_index]\n",
    "        label_els = dd.find_elements(By.CSS_SELECTOR, \"span.shrink-0\")\n",
    "        if not label_els: return None, []\n",
    "        label = label_els[0].text.strip()\n",
    "        if not label: return None, []\n",
    "\n",
    "        # 드롭다운 열기\n",
    "        btn = dd.find_element(By.CSS_SELECTOR, \"button\")\n",
    "        driver.execute_script(\"arguments[0].click();\", btn)\n",
    "        time.sleep(0.5)  # ⭐ 0.8 → 0.5\n",
    "\n",
    "        opt_list = []\n",
    "        prev_count = 0\n",
    "\n",
    "        # 스크롤 컨테이너 탐색\n",
    "        scroll_area = None\n",
    "        try:\n",
    "            scroll_area = driver.find_element(By.CSS_SELECTOR,\n",
    "                \"[class*='overflow-y-auto'], [class*='overflow-auto']\")\n",
    "        except: pass\n",
    "\n",
    "        for _ in range(20):  # 최대 20회 스크롤\n",
    "            opts = driver.find_elements(By.CSS_SELECTOR, \"li.flex.w-full\")\n",
    "            visible = [o for o in opts if o.is_displayed()]\n",
    "\n",
    "            for o in visible:\n",
    "                try:\n",
    "                    lines = o.text.strip().split('\\n')\n",
    "                    name = clean_text_for_system(lines[0]) if lines else ''\n",
    "\n",
    "                    # 가격: '재고 4608개 · ¥6.70' → ¥ 뒤 숫자\n",
    "                    price_cny_opt = 0.0\n",
    "                    if len(lines) > 1:\n",
    "                        m = re.search(r'¥([\\d\\.]+)', lines[1])\n",
    "                        if m: price_cny_opt = float(m.group(1))\n",
    "\n",
    "                    # 이미지\n",
    "                    img_src = ''\n",
    "                    try:\n",
    "                        img_el = o.find_element(By.CSS_SELECTOR, \"img\")\n",
    "                        img_src = (img_el.get_attribute('src') or\n",
    "                                   img_el.get_attribute('data-src') or '')\n",
    "                    except: pass\n",
    "\n",
    "                    if name and not any(x['name'] == name for x in opt_list):\n",
    "                        opt_list.append({'name': name, 'price': price_cny_opt, 'img': img_src})\n",
    "                except: pass\n",
    "\n",
    "            if len(opt_list) == prev_count:\n",
    "                break\n",
    "            prev_count = len(opt_list)\n",
    "\n",
    "            # 스크롤 다운\n",
    "            if scroll_area:\n",
    "                driver.execute_script(\"arguments[0].scrollTop += 300;\", scroll_area)\n",
    "            elif visible:\n",
    "                driver.execute_script(\"arguments[0].scrollIntoView();\", visible[-1])\n",
    "            time.sleep(0.2)  # ⭐ 0.3 → 0.2\n",
    "\n",
    "        # 드롭다운 닫기 (DOM 재탐색)\n",
    "        try:\n",
    "            dds2 = driver.find_elements(By.CSS_SELECTOR, \".option-dropdown\")\n",
    "            btn2 = dds2[dd_index].find_element(By.CSS_SELECTOR, \"button\")\n",
    "            driver.execute_script(\"arguments[0].click();\", btn2)\n",
    "        except: pass\n",
    "        time.sleep(0.2)  # ⭐ 0.3 → 0.2\n",
    "\n",
    "        return label, opt_list\n",
    "\n",
    "    except Exception as e:\n",
    "        return None, []\n",
    "\n",
    "def get_all_options(driver):\n",
    "    \"\"\"\n",
    "    ⭐ 속도 개선: 크기 드롭다운을 한번만 열어서 수집+선택 동시 처리\n",
    "    - 크기 수집 직후 바로 첫번째 항목 선택 (드롭다운 2번 열기 제거)\n",
    "    - StaleElement 방지를 위해 매번 DOM 재탐색\n",
    "    반환: {'크기': [{name, price, img},...], '색상': [...]}\n",
    "    \"\"\"\n",
    "    all_opts = {}\n",
    "\n",
    "    # 유효한 드롭다운 개수 파악\n",
    "    dropdowns = driver.find_elements(By.CSS_SELECTOR, \".option-dropdown\")\n",
    "    dd_count = 0\n",
    "    for dd in dropdowns:\n",
    "        els = dd.find_elements(By.CSS_SELECTOR, \"span.shrink-0\")\n",
    "        if els and els[0].text.strip():\n",
    "            dd_count += 1\n",
    "\n",
    "    if dd_count == 0:\n",
    "        return all_opts\n",
    "\n",
    "    # ── STEP1: 크기 드롭다운 열어서 수집 + 첫번째 선택 동시 처리 ──\n",
    "    try:\n",
    "        dds = driver.find_elements(By.CSS_SELECTOR, \".option-dropdown\")\n",
    "        label_els = dds[0].find_elements(By.CSS_SELECTOR, \"span.shrink-0\")\n",
    "        label0 = label_els[0].text.strip() if label_els else '크기'\n",
    "\n",
    "        btn = dds[0].find_element(By.CSS_SELECTOR, \"button\")\n",
    "        driver.execute_script(\"arguments[0].click();\", btn)\n",
    "        time.sleep(0.5)  # ⭐ 0.8 → 0.5\n",
    "\n",
    "        opts = driver.find_elements(By.CSS_SELECTOR, \"li.flex.w-full\")\n",
    "        visible = [o for o in opts if o.is_displayed()]\n",
    "\n",
    "        # 크기 옵션 수집\n",
    "        opt0_list = []\n",
    "        for o in visible:\n",
    "            try:\n",
    "                lines = o.text.strip().split('\\n')\n",
    "                name = clean_text_for_system(lines[0]) if lines else ''\n",
    "                price_cny_opt = 0.0\n",
    "                if len(lines) > 1:\n",
    "                    m = re.search(r'¥([\\d\\.]+)', lines[1])\n",
    "                    if m: price_cny_opt = float(m.group(1))\n",
    "                img_src = ''\n",
    "                try:\n",
    "                    img_el = o.find_element(By.CSS_SELECTOR, \"img\")\n",
    "                    img_src = img_el.get_attribute('src') or ''\n",
    "                except: pass\n",
    "                if name and not any(x['name'] == name for x in opt0_list):\n",
    "                    opt0_list.append({'name': name, 'price': price_cny_opt, 'img': img_src})\n",
    "            except: pass\n",
    "\n",
    "        if label0:\n",
    "            all_opts[label0] = opt0_list\n",
    "\n",
    "        # ⭐ 수집 직후 바로 첫번째 선택 (드롭다운 닫지 않고 바로 클릭)\n",
    "        if visible and dd_count >= 2:\n",
    "            driver.execute_script(\"arguments[0].click();\", visible[0])\n",
    "            time.sleep(0.7)  # ⭐ 1.0 → 0.7 DOM 재렌더링 대기\n",
    "        else:\n",
    "            # 색상 없으면 그냥 닫기\n",
    "            try:\n",
    "                dds2 = driver.find_elements(By.CSS_SELECTOR, \".option-dropdown\")\n",
    "                btn2 = dds2[0].find_element(By.CSS_SELECTOR, \"button\")\n",
    "                driver.execute_script(\"arguments[0].click();\", btn2)\n",
    "            except: pass\n",
    "            time.sleep(0.2)\n",
    "\n",
    "    except: pass\n",
    "\n",
    "    # ── STEP2: 색상 드롭다운 수집 ──\n",
    "    if dd_count >= 2:\n",
    "        label1, opt1_list = collect_opts_from_dropdown(driver, 1)\n",
    "        if label1:\n",
    "            all_opts[label1] = opt1_list\n",
    "\n",
    "    # ── STEP3: 세번째 드롭다운 있으면 수집 ──\n",
    "    if dd_count >= 3:\n",
    "        label2, opt2_list = collect_opts_from_dropdown(driver, 2)\n",
    "        if label2:\n",
    "            all_opts[label2] = opt2_list\n",
    "\n",
    "    return all_opts\n",
    "\n",
    "def classify_images(driver):\n",
    "    \"\"\"\n",
    "    렌더 크기 기준으로 이미지 분류\n",
    "    - 890px : 메인 대표 이미지\n",
    "    - 62px  : 썸네일\n",
    "    - 790px+: 상세 이미지\n",
    "    - 164px : 관련상품 → 제외\n",
    "    메인 없으면 썸네일 첫번째로 fallback\n",
    "    \"\"\"\n",
    "    main_imgs = []\n",
    "    thumb_imgs = []\n",
    "    detail_imgs = []\n",
    "\n",
    "    all_imgs = driver.find_elements(By.CSS_SELECTOR, \"img[src*='alicdn']\")\n",
    "\n",
    "    for img in all_imgs:\n",
    "        src = img.get_attribute('src') or ''\n",
    "        if not src: continue\n",
    "        w = img.size['width']\n",
    "\n",
    "        if w >= 700:      # 상세 이미지 (790px)\n",
    "            detail_imgs.append(src)\n",
    "        elif w >= 500:    # 메인 대표 이미지 (890px)\n",
    "            main_imgs.append(src)\n",
    "        elif w == 62:     # 썸네일\n",
    "            thumb_imgs.append(src)\n",
    "        # 164px(관련상품) 제외\n",
    "\n",
    "    # ⭐ 메인 없으면 썸네일 첫번째로 fallback\n",
    "    if not main_imgs and thumb_imgs:\n",
    "        main_imgs = [thumb_imgs[0]]\n",
    "\n",
    "    return main_imgs, thumb_imgs, detail_imgs\n",
    "\n",
    "\n",
    "# ──────────────────────────────────────────\n",
    "# 🚀 메인 루프\n",
    "# ──────────────────────────────────────────\n",
    "\n",
    "for index, row in df_original.iterrows():\n",
    "    original_row_dict = row.to_dict()\n",
    "    link_to_search = str(original_row_dict.get('상품링크', '')).strip()\n",
    "\n",
    "    if not link_to_search or str(original_row_dict.get('다운로드여부', '')).upper() == 'TRUE':\n",
    "        crawled_buffer.append({'type': 'skip', 'data': original_row_dict})\n",
    "        continue\n",
    "\n",
    "    print(f\"\\n⚡ [{index+2}] 수집 시작: {link_to_search[:50]}...\")\n",
    "\n",
    "    try:\n",
    "        # 1. itId 추출 → 직접 URL 접근\n",
    "        item_id = extract_itid(link_to_search)\n",
    "        if not item_id:\n",
    "            raise ValueError(f\"itId 추출 실패: {link_to_search}\")\n",
    "\n",
    "        direct_url = f\"https://sellochomes.co.kr/sourcinglife/alibaba/item?itId={item_id}\"\n",
    "        driver.get(direct_url)\n",
    "\n",
    "        # ⭐ option-dropdown 뜰 때까지 대기 (렌더링 완료 신호)\n",
    "        rendered = wait_for_page(driver, timeout=10)\n",
    "        if not rendered:\n",
    "            raise ValueError(\"페이지 렌더링 타임아웃\")\n",
    "\n",
    "        # 2. 상품명/가격 추출\n",
    "        body_text = driver.find_element(By.TAG_NAME, \"body\").text\n",
    "        title, price_krw, price_cny = parse_body_text(body_text)\n",
    "        print(f\"    📌 상품명: {title[:40]}\")\n",
    "        print(f\"    💰 가격: ₩{price_krw:,.0f} / ¥{price_cny}\")\n",
    "\n",
    "        # 3. 이미지 분류 (옵션 수집 전에! 드롭다운 클릭 전 상태)\n",
    "        main_imgs, thumb_imgs, detail_imgs = classify_images(driver)\n",
    "\n",
    "        # 4. 옵션 수집\n",
    "        options = get_all_options(driver)\n",
    "        opt_keys = list(options.keys())\n",
    "        opt1_key = opt_keys[0] if len(opt_keys) > 0 else '옵션1'\n",
    "        opt2_key = opt_keys[1] if len(opt_keys) > 1 else None\n",
    "        opt1_final = options.get(opt1_key, [])\n",
    "        opt2_final = options.get(opt2_key, []) if opt2_key else []\n",
    "\n",
    "        # 옵션 가격 0이면 메인 가격으로 대체\n",
    "        for o in opt1_final + opt2_final:\n",
    "            if o['price'] == 0.0:\n",
    "                o['price'] = price_cny\n",
    "\n",
    "        # ⭐ 스위칭 판단 (구버전 로직 유지)\n",
    "        opt1_has_img = any(o['img'] for o in opt1_final)\n",
    "        opt2_has_img = any(o['img'] for o in opt2_final)\n",
    "        is_switched = (\n",
    "            bool(opt1_final) and bool(opt2_final)\n",
    "            and not opt1_has_img\n",
    "            and opt2_has_img\n",
    "        )\n",
    "\n",
    "        # 로그 출력 (구버전 양식 유지)\n",
    "        first_p = opt2_final[0]['price'] if opt2_final else (opt1_final[0]['price'] if opt1_final else 0.0)\n",
    "        print(f\"    💰 가격분석 완료 첫번째 가격: {first_p}\")\n",
    "\n",
    "        if is_switched:\n",
    "            print(f\"    📸 옵션이미지({opt2_key}): {len([o for o in opt2_final if o['img']])}장\")\n",
    "            print(f\"    🔄 [스위칭 적용] {opt2_key}가 메인 이미지로 설정됩니다.\")\n",
    "        else:\n",
    "            print(f\"    📸 옵션이미지({opt1_key}): {len([o for o in opt1_final if o['img']])}장\")\n",
    "\n",
    "        if opt2_final:\n",
    "            print(f\"    ✅ {opt1_key}({len(opt1_final)}개) / {opt2_key}({len(opt2_final)}개) 원천 데이터 확보\")\n",
    "        elif opt1_final:\n",
    "            print(f\"    ✅ {opt1_key}({len(opt1_final)}개) 단독 옵션 확보\")\n",
    "        else:\n",
    "            print(f\"    ✅ 옵션 없음 - 단일 상품\")\n",
    "\n",
    "        print(f\"    🖼️ 메인:{len(main_imgs)}장 / 썸네일:{len(thumb_imgs)}장 / 상세:{len(detail_imgs)}장\")\n",
    "\n",
    "        # 5. 버퍼 저장\n",
    "        crawled_buffer.append({\n",
    "            'type': 'new',\n",
    "            'original_row': original_row_dict,\n",
    "            'common_info': {\n",
    "                'orig_name': clean_text_for_system(title),\n",
    "                'main_imgs': main_imgs,\n",
    "                'thumb_imgs': thumb_imgs,\n",
    "                'detail_urls': detail_imgs\n",
    "            },\n",
    "            'opt1': opt1_final,\n",
    "            'opt2': opt2_final,\n",
    "            'is_switched': is_switched,\n",
    "            'price_krw': price_krw,\n",
    "            'price_cny': price_cny\n",
    "        })\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f\"❌ 오류 발생: {e}\")\n",
    "        crawled_buffer.append({'type': 'error', 'data': original_row_dict})\n",
    "\n",
    "print(f\"\\n🎉 [ Cell 4-1 ] 데이터 원천 수집 완료! 총 {len(crawled_buffer)}건 처리\")\n"
