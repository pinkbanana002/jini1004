    "# [ Cell 0: 통합 환경 설정] \n",
    "# 26.4.01\n",
    "\n",
    "\n",
    "\n",
    "import os\n",
    "\n",
    "# ==============================================================\n",
    "# 📢 [1] 사용자 필수 입력란 (본인의 정보로 채워주세요!)\n",
    "# ==============================================================\n",
    "# 1. 구글 스프레드시트 설정\n",
    "# (다운로드 받은 credentials.json 파일을 같은 폴더에 넣어주세요)\n",
    "GOOGLE_JSON_FILE = 'credentials.json' \n",
    "# 👇 아래 따옴표 안에 본인의 구글 시트 주소를 넣으세요\n",
    "GOOGLE_SHEET_URL = \"https://docs.google.com/spreadsheets/d/1X0RklZG_HNQyXQ9dxWKR-esRPyF2E48C4KOaoacJ-9M/edit?gid=0#gid=0\" \n",
    "TARGET_SHEET_NAME = \"상품등록목록\" \n",
    "\n",
    "# 2. Gemini API 키 (https://aistudio.google.com/app/apikey)\n",
    "# 👇 아래 따옴표 안에 생성한 API 키를 붙여넣으세요\n",
    "GEMINI_API_KEY = \"AIzaSyCuTuRY6LzfmVWgZ0tKj-Sr3gU3chCF-N0\" \n",
    "\n",
    "# 3. 서플라이허브(쿠팡) 로그인 정보\n",
    "SUPPLY_ID = \"pinkbanana1\"        # 👈 본인의 쿠팡 아이디 입력\n",
    "SUPPLY_PW = \"pink8540@@\"        # 👈 본인의 쿠팡 비밀번호 입력\n",
    "\n",
    "# 4. 내 브랜드 및 사업자 정보\n",
    "MY_BRAND_NAME = \"몰투데이\"       # 👈 예: 쿠썸\n",
    "MY_COMPANY_NAME = \"분홍바나나\"     # 👈 예: 주식회사 000\n",
    "MY_PHONE_NUMBER = \"1577-7011\"     # 👈 예: 010-0000-0000 (CS용 전화번호)\n",
    "\n",
    "\n",
    "# 💰 [5] 쿠팡 가격/마진 수식 설정 (원하는대로 숫자를 변경하세요)\n",
    "EXCHANGE_FACTOR = 350       # 1688단가 적용 배수 (환율 200원 + 각종 수수료 및 마진)\n",
    "ADD_LOGISTICS_COST = 4000   # 추가 비용 (해외배송비 + 국내택배비 + 포장비 등)\n",
    "SALE_PRICE_RATE = 1.67      # 쿠팡판매가 배수 (공급가 * 1.67 => 마진 약 40% 설정)\n",
    "REC_PRICE_RATE = 1.30       # 권장가(소비자가) 배수 (할인율 노출을 위해 판매가보다 높게 설정)\n",
    "ROUND_UNIT = -2             # 가격 반올림 단위 (-2는 10원 단위 버리고 100원 단위로 맞춤)\n",
    "\n",
    "# ==============================================================\n",
    "# 📂 [2] 경로 자동 설정 (시스템이 자동으로 잡습니다. 건드리지 마세요!)\n",
    "# ==============================================================\n",
    "# 1. 현재 작업 폴더 (가장 먼저 정의해야 합니다!)\n",
    "BASE_DRIVE = os.getcwd()\n",
    "\n",
    "# 2. 상세페이지 제작용 템플릿 및 폰트 경로\n",
    "# (이 주피터 노트북 파일과 같은 폴더에 'templates', 'fonts' 폴더가 있어야 합니다)\n",
    "PATH_TEMPLATES = os.path.join(BASE_DRIVE, \"templates\")\n",
    "PATH_FONTS     = os.path.join(BASE_DRIVE, \"fonts\")\n",
    "\n",
    "# 3. 폰트 파일명 설정 (fonts 폴더에 넣은 파일명과 똑같이 적으세요)\n",
    "# ⚠️ 주의: 파일명이 다르면 에러가 납니다. 꼭 확인하세요!\n",
    "FONT_BOLD    = \"강원교육모두 Bold.ttf\"\n",
    "FONT_REGULAR = \"강원교육모두 Light.ttf\"\n",
    "\n",
    "# 4. 기타 시스템 경로\n",
    "# 내 컴퓨터의 '다운로드' 폴더 자동 감지\n",
    "MY_DOWNLOAD_DIR = os.path.join(os.path.expanduser(\"~\"), \"Downloads\")\n",
    "\n",
    "\n",
    "# ‼️ [수정됨] 크롬 프로필 경로를 현재 폴더 내부로 변경 (호환성 해결)\n",
    "# 기존 C:\\ 방식은 수강생 PC 환경에 따라 에러가 날 수 있어 상대 경로로 변경했습니다.\n",
    "PATH_PROFILE = os.path.join(BASE_DRIVE, \"chrome_profile\")\n",
    "\n",
    "# ==============================================================\n",
    "# 📂 [3] 필수 폴더 자동 생성 로직\n",
    "# ==============================================================\n",
    "PATH_DOWNLOAD   = os.path.join(BASE_DRIVE, \"temp_downloads\") # 임시 다운로드 폴더\n",
    "PATH_COMPLETED  = os.path.join(BASE_DRIVE, \"완료된_상품\")   # 결과물이 저장될 폴더\n",
    "\n",
    "# 필요한 모든 폴더가 없으면 자동으로 생성합니다.\n",
    "required_paths = [BASE_DRIVE, PATH_TEMPLATES, PATH_FONTS, PATH_DOWNLOAD, PATH_PROFILE, PATH_COMPLETED]\n",
    "\n",
    "for p in required_paths:\n",
    "    if not os.path.exists(p):\n",
    "        os.makedirs(p)\n",
    "        print(f\"✨ 폴더 생성 완료: {p}\")\n",
    "\n",
    "print(\"-\" * 50)\n",
    "print(f\"📂 작업 기준 폴더: {BASE_DRIVE}\")\n",
    "print(f\"🎨 템플릿 폴더: {PATH_TEMPLATES}\")\n",
    "print(f\"🚀 [환경 설정 완료] 위 입력란(API키, 아이디 등)을 모두 채우셨다면 다음 단계로 넘어가세요!\")"
   ]
