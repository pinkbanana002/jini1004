    "# [ Cell 2: 구글 시트 연결 및 데이터 불러오기 ]\n",
    "import gspread\n",
    "import pandas as pd\n",
    "import os\n",
    "\n",
    "print(\"▶️ [ Cell 2 ] 구글 시트와 연결을 시도합니다...\")\n",
    "\n",
    "# ==============================================================\n",
    "# 🚨 [안전장치 1] Cell 0 실행 여부 체크\n",
    "# ==============================================================\n",
    "if 'GOOGLE_JSON_FILE' not in globals() or 'GOOGLE_SHEET_URL' not in globals():\n",
    "    print(\"\\n❌ [오류] 필수 설정값이 없습니다!\")\n",
    "    print(\"    👉 맨 위 [ Cell 0 ]을 먼저 실행(Shift+Enter)해주세요.\")\n",
    "    # 더 이상 진행하지 않도록 에러 발생\n",
    "    raise NameError(\"Cell 0 미실행 오류\")\n",
    "\n",
    "# ==============================================================\n",
    "# 🚨 [안전장치 2] json 키 파일 존재 여부 체크\n",
    "# ==============================================================\n",
    "if not os.path.exists(GOOGLE_JSON_FILE):\n",
    "    print(f\"\\n❌ [오류] '{GOOGLE_JSON_FILE}' 파일이 없습니다!\")\n",
    "    print(\"    👉 다운로드 받은 인증 키(json) 파일을 이 폴더에 드래그해서 넣어주세요.\")\n",
    "    raise FileNotFoundError(\"인증 파일 없음\")\n",
    "\n",
    "try:\n",
    "    # 1. 인증 파일(열쇠) 설정\n",
    "    gc = gspread.service_account(filename=GOOGLE_JSON_FILE)\n",
    "\n",
    "    # 2. 작업할 구글 스프레드시트 주소 입력\n",
    "    doc = gc.open_by_url(GOOGLE_SHEET_URL)\n",
    "    \n",
    "    # 3. 해당 탭(Worksheet) 선택\n",
    "    worksheet = doc.worksheet(TARGET_SHEET_NAME)\n",
    "    \n",
    "    # 4. 데이터를 파이썬 데이터프레임(DataFrame)으로 변환\n",
    "    all_rows = worksheet.get_all_values()\n",
    "    \n",
    "    if len(all_rows) < 1:\n",
    "        print(\"⚠️ 시트가 비어있습니다. 데이터를 채워주세요.\")\n",
    "        df_original = pd.DataFrame()\n",
    "    else:\n",
    "        # 첫 줄은 헤더, 나머지는 데이터\n",
    "        headers = all_rows[0]\n",
    "        data = all_rows[1:]\n",
    "        df_original = pd.DataFrame(data, columns=headers)\n",
    "    \n",
    "    # 결과 출력\n",
    "    print(f\"\\n✅ '{TARGET_SHEET_NAME}' 탭 확인 완료!\")\n",
    "    print(f\"📦 총 {len(df_original)}개의 상품 데이터를 가져왔습니다.\")\n",
    "    \n",
    "    if not df_original.empty:\n",
    "        print(\"\\n--- 📋 불러온 데이터 미리보기 (상위 3개) ---\")\n",
    "        print(df_original.head(3))\n",
    "\n",
    "    # 5. [추가됨] 최종 성공 메시지\n",
    "    print(\"\\n\" + \"=\"*60)\n",
    "    print(f\"🎉 구글 시트와 연결이 잘 되었습니다!\")\n",
    "    print(f\"👉 이제 다음 단계([ Cell 3 ])로 넘어가셔도 좋습니다.\")\n",
    "    print(\"=\"*60)\n",
    "\n",
    "except gspread.exceptions.WorksheetNotFound:\n",
    "    print(f\"\\n❌ [오류] 시트 탭 이름 확인 필요: '{TARGET_SHEET_NAME}' 탭이 없습니다.\")\n",
    "    print(\"    👉 구글 시트 하단의 탭 이름이 정확한지 확인하세요.\")\n",
    "except Exception as e:\n",
    "    print(f\"\\n❌ [오류] 연결 실패: {e}\")\n",
    "    print(\"    👉 해결법: 1) JSON 파일 내용 확인, 2) 시트 공유 권한 확인, 3) Cell 0 주소 확인\")"
   ]
  },
