   "source": [
    "# [ Cell 3: 브라우저 실행 및 환경설정 ]\n",
    "import time\n",
    "import os\n",
    "from selenium import webdriver\n",
    "from selenium.webdriver.chrome.service import Service\n",
    "from webdriver_manager.chrome import ChromeDriverManager\n",
    "\n",
    "print(\"▶️ [ Cell 3 ] 크롬 브라우저를 설정하고 실행합니다...\")\n",
    "\n",
    "# ==============================================================\n",
    "# 🚨 [안전장치] Cell 0 실행 여부 체크\n",
    "# ==============================================================\n",
    "if 'MY_DOWNLOAD_DIR' not in globals():\n",
    "    print(\"\\n❌ [오류] 다운로드 경로 설정이 없습니다.\")\n",
    "    print(\"   👉 [ Cell 0 ]을 먼저 실행해주세요!\")\n",
    "    raise NameError(\"Cell 0 미실행 오류\")\n",
    "\n",
    "# 1. 크롬 옵션 설정\n",
    "options = webdriver.ChromeOptions()\n",
    "options.add_argument(\"--start-maximized\") # 전체 화면 시작\n",
    "options.add_argument(\"--lang=ko-KR\")      # 한국어 설정\n",
    "options.add_argument(\"--disable-gpu\")     # 그래픽 가속 끄기 (에러 방지)\n",
    "options.add_argument(\"--no-sandbox\")      # 보안 샌드박스 끄기 (호환성 향상)\n",
    "\n",
    "# 2. ⚙️ [핵심 수정] 다운로드 경로 고정 및 팝업 차단\n",
    "prefs = {\n",
    "    \"translate_whitelists\": {\"zh-CN\": \"ko\"},  # 중국어 -> 한국어 자동 번역\n",
    "    \"translate\": {\"enabled\": \"true\"},\n",
    "    \"download.default_directory\": MY_DOWNLOAD_DIR, # 👈 Cell 0에서 설정한 경로로 강제 고정\n",
    "    \"download.prompt_for_download\": False,         # 저장할지 물어보는 팝업 끄기\n",
    "    \"profile.default_content_settings.popups\": 0,  # 팝업 차단\n",
    "    \"safebrowsing.enabled\": True                   # 안전한 브라우징\n",
    "}\n",
    "options.add_experimental_option(\"prefs\", prefs)\n",
    "\n",
    "# 3. 드라이버 실행\n",
    "try:\n",
    "    # 드라이버 자동 설치 및 실행\n",
    "    service = Service(ChromeDriverManager().install())\n",
    "    driver = webdriver.Chrome(service=service, options=options)\n",
    "    \n",
    "    # ⏳ [추가됨] 암묵적 대기 (요소가 나올 때까지 최대 10초 기다려줌)\n",
    "    driver.implicitly_wait(10)\n",
    "    \n",
    "    print(\"✅ 브라우저 실행 성공! (다운로드 경로가 설정됨)\")\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"❌ 드라이버 실행 실패: {e}\")\n",
    "    print(\"   👉 크롬 브라우저가 켜져 있다면 모두 끄고 다시 실행해보세요.\")\n",
    "    raise e\n",
    "\n",
    "# 4. 목표 사이트 접속 (경로 수정됨 🌟)\n",
    "target_url = \"https://sellochomes.co.kr/sourcinglife/\"\n",
    "print(f\"▶️ 사이트로 이동합니다: {target_url}\")\n",
    "\n",
    "try:\n",
    "    driver.get(target_url)\n",
    "    print(f\"✅ 접속 성공! 현재 페이지: {driver.title}\")\n",
    "    print(\"\\n🚀 [준비 완료] 브라우저 창을 띄워둔 상태로 다음 단계(수집)를 진행하세요.\")\n",
    "except Exception as e:\n",
    "    print(f\"⚠️ 사이트 접속 중 경고: {e}\")"
   ]
