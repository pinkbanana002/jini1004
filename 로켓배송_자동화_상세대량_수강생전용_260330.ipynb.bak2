   "source": [
    "# [ Cell 1: 필수 라이브러리 자동 체크 및 로드 ]\n",
    "import sys\n",
    "import subprocess\n",
    "import time\n",
    "import os\n",
    "\n",
    "print(\"▶️ [ Cell 1 ] 로봇 가동을 위한 필수 도구를 점검합니다...\")\n",
    "\n",
    "# ==============================================================\n",
    "# 🛠️ 1. 필수 라이브러리 목록 정의\n",
    "# (왼쪽: 설치할 이름 / 오른쪽: 코드에서 불러올 이름)\n",
    "# ==============================================================\n",
    "required_libraries = {\n",
    "    'gspread': 'gspread',\n",
    "    'oauth2client': 'oauth2client',  # 👈 구글 인증용 (추가됨)\n",
    "    'pandas': 'pandas',\n",
    "    'requests': 'requests',\n",
    "    'Pillow': 'PIL',\n",
    "    'selenium': 'selenium',\n",
    "    'webdriver-manager': 'webdriver_manager',\n",
    "    'gspread-dataframe': 'gspread_dataframe',\n",
    "    'undetected-chromedriver': 'undetected_chromedriver',\n",
    "    'openpyxl': 'openpyxl',\n",
    "    'google-generativeai': 'google.generativeai',\n",
    "    'deep-translator': 'deep_translator'\n",
    "}\n",
    "\n",
    "# ==============================================================\n",
    "# ⚙️ 2. 자동 설치 및 검증 로직\n",
    "# ==============================================================\n",
    "def install_and_check():\n",
    "    missing = []\n",
    "    \n",
    "    # 1차 점검: 설치 안 된 것 찾기\n",
    "    for lib_name, import_name in required_libraries.items():\n",
    "        try:\n",
    "            __import__(import_name)\n",
    "        except ImportError:\n",
    "            missing.append(lib_name)\n",
    "    \n",
    "    # 미설치 항목이 있다면 설치 진행\n",
    "    if missing:\n",
    "        print(f\"📦 미설치 도구 발견: {', '.join(missing)}\")\n",
    "        print(\"🛠️ 자동으로 설치를 시작합니다. (인터넷 환경에 따라 시간이 소요됩니다...)\")\n",
    "        \n",
    "        for lib in missing:\n",
    "            try:\n",
    "                # pip install 명령어를 파이썬 내부에서 실행\n",
    "                subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", lib])\n",
    "                print(f\"    ✅ {lib} 설치 완료\")\n",
    "            except Exception as e:\n",
    "                print(f\"    ❌ {lib} 설치 실패: {e}\")\n",
    "                print(\"       (수동으로 'pip install 라이브러리명'을 입력해야 할 수도 있습니다.)\")\n",
    "        \n",
    "        print(\"🎉 설치 작업이 끝났습니다. 다시 한번 검증합니다.\")\n",
    "        time.sleep(1)\n",
    "    else:\n",
    "        print(\"✅ 모든 필수 라이브러리가 이미 완벽하게 설치되어 있습니다.\")\n",
    "\n",
    "# 설치 함수 실행\n",
    "install_and_check()\n",
    "\n",
    "# ==============================================================\n",
    "# 🚀 3. 라이브러리 불러오기 (Import)\n",
    "# ==============================================================\n",
    "import gspread\n",
    "from oauth2client.service_account import ServiceAccountCredentials # 👈 인증 모듈 미리 로드\n",
    "import pandas as pd\n",
    "import requests\n",
    "import re\n",
    "import shutil\n",
    "import json\n",
    "import glob\n",
    "import random\n",
    "from io import BytesIO\n",
    "from PIL import Image, ImageDraw, ImageFont \n",
    "import textwrap\n",
    "\n",
    "# 셀레니움 (웹 자동화) 관련\n",
    "from selenium import webdriver\n",
    "from selenium.webdriver.common.by import By\n",
    "from selenium.webdriver.common.keys import Keys\n",
    "from selenium.webdriver.chrome.service import Service\n",
    "from selenium.webdriver.support.ui import WebDriverWait\n",
    "from selenium.webdriver.support import expected_conditions as EC\n",
    "from webdriver_manager.chrome import ChromeDriverManager\n",
    "import undetected_chromedriver as uc\n",
    "\n",
    "# 엑셀 및 구글 시트 관련\n",
    "from gspread_dataframe import set_with_dataframe\n",
    "import openpyxl\n",
    "from openpyxl.styles import PatternFill\n",
    "\n",
    "# AI 관련\n",
    "import google.generativeai as genai\n",
    "from deep_translator import GoogleTranslator\n",
    "\n",
    "print(\"-\" * 50)\n",
    "print(\"🚀 [성공] 모든 도구(라이브러리)가 준비되었습니다.\")\n",
    "print(\"    이제 [ Cell 2 ]로 넘어가서 구글 시트를 연결해주세요!\")\n",
    "print(\"-\" * 50)"
   ]
  },
